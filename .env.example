# --- Administration (/admin) ---
# Mot de passe de l'espace client. Obligatoire pour activer l'admin.
ADMIN_PASSWORD=changez-moi
# Secret de signature du cookie de session (chaîne longue et aléatoire).
ADMIN_SECRET=

# --- Formulaire de devis ---
# Clé API Resend (https://resend.com). Sans clé, les demandes sont journalisées dans la console serveur.
RESEND_API_KEY=
# Destinataire des demandes (par défaut : l'e-mail défini dans content/site.json).
DEVIS_TO_EMAIL=
# Expéditeur (domaine vérifié chez Resend).
DEVIS_FROM_EMAIL="RND Élagage <devis@rnd-elagage.fr>"

# --- Stockage du contenu et des photos (Vercel uniquement) ---
# Jeton du store Vercel Blob. Quand il est défini, les JSON modifiés depuis l'admin
# et les photos envoyées sont stockés dans Blob (le disque est en lecture seule sur
# Vercel). Sans jeton : écriture dans content/ et public/uploads/ (dev, VPS).
# Sur Vercel il est injecté automatiquement par le store lié au projet.
# Ne PAS le mettre dans .env.local en dev : l'admin local écrirait dans le store de prod.
BLOB_READ_WRITE_TOKEN=

# --- Mesure d'audience / Google Ads (chargé seulement après consentement) ---
NEXT_PUBLIC_GTAG_ID=
